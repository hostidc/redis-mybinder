#!/bin/bash
# ============================================
# MyBinder postBuild 脚本
# 用于配置 Redis、MongoDB 服务器、NVM、Node.js 和其他自定义设置
# ============================================

set -e

echo "========================================="
echo "Starting postBuild configuration..."
echo "========================================="

# -------------------------------------------
# 1. 配置 Redis 服务器
# -------------------------------------------
echo ""
echo ">>> Configuring Redis server..."

# 创建 Redis 数据目录
mkdir -p /tmp/redis-data
chmod 755 /tmp/redis-data

# 创建 Redis 配置文件
cat > /tmp/redis.conf << 'EOF'
# Redis 基础配置
bind 127.0.0.1
port 6379
daemonize yes
dir /tmp/redis-data

# 持久化配置（可选）
save 60 1
save 300 10

# 日志配置
loglevel notice
logfile /tmp/redis.log

# 内存管理
maxmemory 256mb
maxmemory-policy allkeys-lru

# 安全配置（开发环境可注释）
# requirepass your_password_here
# rename-command FLUSHDB ""
# rename-command FLUSHALL ""
EOF

echo "✓ Redis configuration created at /tmp/redis.conf"

# -------------------------------------------
# 2. 安装 MongoDB 服务器
# -------------------------------------------
echo ""
echo ">>> Installing MongoDB server..."

# 检测系统架构
ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
    MONGO_ARCH="x86_64"
elif [ "$ARCH" = "aarch64" ]; then
    MONGO_ARCH="aarch64"
else
    echo "✗ Unsupported architecture: $ARCH"
    exit 1
fi

echo "   Detected architecture: $MONGO_ARCH"

# 设置 MongoDB 版本和下载 URL
MONGO_VERSION="7.0.14"
MONGO_URL="https://fastdl.mongodb.org/linux/mongodb-linux-${MONGO_ARCH}-ubuntu2204-${MONGO_VERSION}.tgz"
# 使用用户有权限的目录（/opt 需要 root 权限）
MONGO_DIR="$HOME/.local/mongodb"

# 下载并安装 MongoDB
echo "   Downloading MongoDB $MONGO_VERSION..."
cd /tmp
wget -q "$MONGO_URL" -O mongodb.tgz

# 解压到用户目录
mkdir -p $MONGO_DIR
tar xzf mongodb.tgz --strip-components=1 -C $MONGO_DIR

# 清理下载文件
rm mongodb.tgz

# 创建符号链接到用户 bin 目录
USER_BIN="$HOME/.local/bin"
mkdir -p $USER_BIN
ln -sf $MONGO_DIR/bin/mongod $USER_BIN/mongod
ln -sf $MONGO_DIR/bin/mongos $USER_BIN/mongos
ln -sf $MONGO_DIR/bin/mongosh $USER_BIN/mongosh
ln -sf $MONGO_DIR/bin/mongoexport $USER_BIN/mongoexport
ln -sf $MONGO_DIR/bin/mongoimport $USER_BIN/mongoimport

# 确保用户 bin 目录在 PATH 中
if ! echo "$PATH" | grep -q "$USER_BIN"; then
    export PATH="$USER_BIN:$PATH"
    # 添加到 shell 配置文件
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.bashrc
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.profile
fi

# 验证安装
if command -v mongod &> /dev/null; then
    MONGO_VER=$(mongod --version | head -n 1)
    echo "✓ MongoDB installed: $MONGO_VER"
else
    echo "✗ MongoDB installation failed!"
    exit 1
fi

# 创建 MongoDB 数据目录和配置文件
MONGO_DATA_DIR="/tmp/mongodb-data"
MONGO_LOG_DIR="/tmp/mongodb-log"
mkdir -p $MONGO_DATA_DIR $MONGO_LOG_DIR
chmod 755 $MONGO_DATA_DIR $MONGO_LOG_DIR

# 创建 MongoDB 配置文件（MongoDB 7.0+ 已移除 journal.enabled 选项）
cat > /tmp/mongod.conf << 'EOF'
# MongoDB 配置文件
systemLog:
  destination: file
  path: /tmp/mongodb-log/mongod.log
  logAppend: true

storage:
  dbPath: /tmp/mongodb-data
  # WiredTiger 引擎默认启用 journaling，无需显式配置

net:
  bindIp: 127.0.0.1
  port: 27017

processManagement:
  fork: true

# security:
#   authorization: enabled  # 生产环境启用认证
EOF

echo "✓ MongoDB configuration created at /tmp/mongod.conf"
echo "   Data directory: $MONGO_DATA_DIR"
echo "   Log directory: $MONGO_LOG_DIR"

cd ~

# -------------------------------------------
# 3. 安装 Python MongoDB 客户端（可选）
# -------------------------------------------
echo ""
echo ">>> Installing Python MongoDB client..."

if command -v pip3 &> /dev/null; then
    pip3 install pymongo --quiet
    echo "✓ Python MongoDB client (pymongo) installed"
else
    echo "⚠ pip3 not found, skipping Python MongoDB client installation"
fi

# -------------------------------------------
# 4. 安装 Python Redis 客户端（可选）
# -------------------------------------------
echo ""
echo ">>> Installing Python Redis client..."

if command -v pip3 &> /dev/null; then
    pip3 install redis --quiet
    echo "✓ Python Redis client installed"
else
    echo "⚠ pip3 not found, skipping Python Redis client installation"
fi

# -------------------------------------------
# 5. 验证 Redis 安装
# -------------------------------------------
echo ""
echo ">>> Verifying Redis installation..."

if command -v redis-server &> /dev/null; then
    REDIS_VERSION=$(redis-server --version)
    echo "✓ Redis server installed: $REDIS_VERSION"
else
    echo "✗ Redis server not found!"
    exit 1
fi

if command -v redis-cli &> /dev/null; then
    echo "✓ Redis CLI tool available"
else
    echo "✗ Redis CLI tool not found!"
    exit 1
fi

# -------------------------------------------
# 6. 安装 NVM (Node Version Manager)
# -------------------------------------------
echo ""
echo ">>> Installing NVM (Node Version Manager)..."

# 设置 NVM 版本和 Node.js 版本
export NVM_DIR="$HOME/.nvm"
NVM_VERSION="v0.39.7"
NODE_VERSION="v22.22.2"  # LTS 版本

# 下载并安装 NVM
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/$NVM_VERSION/install.sh | bash

# 加载 NVM
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

echo "✓ NVM installed successfully"

# -------------------------------------------
# 7. 安装 Node.js
# -------------------------------------------
echo ""
echo ">>> Installing Node.js $NODE_VERSION..."

# 使用 NVM 安装 Node.js LTS 版本
nvm install $NODE_VERSION
nvm use $NODE_VERSION
nvm alias default $NODE_VERSION

# 验证 Node.js 和 npm 安装
NODE_VERSION_INSTALLED=$(node --version)
NPM_VERSION_INSTALLED=$(npm --version)
echo "✓ Node.js installed: $NODE_VERSION_INSTALLED"
echo "✓ npm installed: $NPM_VERSION_INSTALLED"

# -------------------------------------------
# 8. 安装 pnpm
# -------------------------------------------
echo ""
echo ">>> Installing pnpm..."

# 使用 npm 安装 pnpm
npm install -g pnpm

# 验证 pnpm 安装
PNPM_VERSION=$(pnpm --version)
echo "✓ pnpm installed: $PNPM_VERSION"

# -------------------------------------------
# 9. 配置环境变量（持久化）
# -------------------------------------------
echo ""
echo ">>> Configuring environment variables..."

# 将 NVM 配置添加到 shell 配置文件
cat >> ~/.bashrc << 'BASHRC_EOF'

# NVM Configuration
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
BASHRC_EOF

# 如果存在 .profile 也添加配置
if [ -f ~/.profile ]; then
    cat >> ~/.profile << 'PROFILE_EOF'

# NVM Configuration
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
PROFILE_EOF
fi

echo "✓ Environment variables configured"

# -------------------------------------------
# 10. 其他自定义配置（可扩展）
# -------------------------------------------
echo ""
echo ">>> Running additional configurations..."

# 在这里添加其他需要的配置

echo ""
echo "========================================="
echo "postBuild completed successfully!"
echo "========================================="
echo ""
echo "Installed tools:"
echo "  - Redis Server: $(redis-server --version)"
echo "  - NVM: $(nvm --version)"
echo "  - Node.js: $(node --version)"
echo "  - npm: $(npm --version)"
echo "  - pnpm: $(pnpm --version)"
echo "========================================="
